# Neon PostgreSQL, supplied by the Vercel Marketplace integration
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
# Vercel Blob token, supplied by the Blob Marketplace integration
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace-me
# Optional, used only to build absolute attachment URLs
AUTH_URL=http://localhost:3000
